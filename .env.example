# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Application
NODE_ENV=production
NEXT_PUBLIC_APP_URL="https://harmelearn.com"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRATION="30d"

# Session
SESSION_ENCRYPTION_KEY="your-session-encryption-key-32-chars-min"
SESSION_MAX_AGE=2592000

# Email Service
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@harmelearn.com"
SMTP_FROM_NAME="HarmeLearn Academy"

# Payment Processing (Stripe)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Payment Processing (Chapa - Ethiopian)
CHAPA_API_KEY="chapa_key_..."
CHAPA_SECRET_KEY="chapa_secret_..."

# Video Hosting
YOUTUBE_API_KEY="your-youtube-api-key"
VIMEO_ACCESS_TOKEN="your-vimeo-token"

# File Upload
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES="pdf,doc,docx,xls,xlsx,ppt,pptx,jpg,jpeg,png,mp4,avi"

# Cloud Storage (Optional - AWS S3)
AWS_REGION="af-south-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_S3_BUCKET="harmelearn-uploads"

# Video Conference (Zoom)
ZOOM_API_KEY="your-zoom-api-key"
ZOOM_API_SECRET="your-zoom-secret"
ZOOM_CLIENT_ID="your-zoom-client-id"

# Video Conference (Google Meet)
GOOGLE_OAUTH_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_OAUTH_CLIENT_SECRET="your-google-oauth-secret"

# Analytics
GOOGLE_ANALYTICS_ID="G-..."
POSTHOG_API_KEY="phc_..."

# Redis Cache (Optional)
REDIS_URL="redis://localhost:6379"

# Logging
LOG_LEVEL="info"
SENTRY_DSN="https://your-sentry-dsn"

# Third-party Services
AI_API_KEY="your-openai-or-claude-api-key"
AI_MODEL="gpt-4"

# Feature Flags
ENABLE_LIVE_CLASSES=true
ENABLE_AI_TUTOR=true
ENABLE_PAYMENTS=true
ENABLE_NOTIFICATIONS=true
ENABLE_FORUM=true

# Regional Settings
TIMEZONE="Africa/Addis_Ababa"
CURRENCY="ETB"
LANGUAGE="en"
